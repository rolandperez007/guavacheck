{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.guavacheck.ai/foundation/Pile.schema.json",
  "title": "Pile Foundation",
  "type": "object",

  "additionalProperties": false,

  "properties": {

    "pileId": {

      "type": "string"

    },

    "pileType": {

      "enum": [

        "BORED",

        "DRIVEN",

        "TIMBER",

        "STEEL",

        "PRECAST",

        "CAST_IN_SITU"

      ]

    },

    "diameter": {

      "type": "number"

    },

    "length": {

      "type": "number"

    },

    "safeWorkingLoad": {

      "type": "number"

    },

    "terminationDepth": {

      "type": "number"

    },

    "pileCapId": {

      "type": "string"

    }

  }

}