{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.guavacheck.ai/structural/Column.schema.json",
  "title": "Structural Column",
  "type": "object",
  "additionalProperties": false,

  "properties": {

    "columnId": {
      "type": "string"
    },

    "columnType": {

      "enum": [

        "RECTANGULAR",

        "SQUARE",

        "CIRCULAR",

        "STEEL",

        "COMPOSITE"

      ]

    },

    "material": {
      "type": "string"
    },

    "width": {
      "type": "number"
    },

    "depth": {
      "type": "number"
    },

    "height": {
      "type": "number"
    },

    "concreteGrade": {
      "type": "string"
    },

    "reinforcementGrade": {
      "type": "string"
    },

    "axialLoad": {
      "type": "number"
    },

    "momentCapacity": {
      "type": "number"
    },

    "fireRatingHours": {
      "type": "number"
    }

  }

}