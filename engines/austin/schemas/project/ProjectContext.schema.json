{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.guavacheck.ai/project/ProjectContext.schema.json",
  "title": "Project Context",
  "description": "Complete contextual information Austin uses before making any engineering, financial or legal decision.",
  "type": "object",
  "additionalProperties": false,

  "properties": {

    "location": {

      "type": "object",

      "properties": {

        "country": {
          "type": "string"
        },

        "state": {
          "type": "string"
        },

        "city": {
          "type": "string"
        },

        "district": {
          "type": "string"
        },

        "latitude": {
          "type": "number"
        },

        "longitude": {
          "type": "number"
        }

      }

    },

    "environment": {

      "type": "object",

      "properties": {

        "terrain": {
          "type": "string"
        },

        "soilType": {
          "type": "string"
        },

        "weatherZone": {
          "type": "string"
        },

        "floodRisk": {
          "type": "string"
        },

        "earthquakeRisk": {
          "type": "string"
        }

      }

    },

    "stakeholders": {

      "type": "array",

      "items": {

        "type": "string"

      }

    },

    "constraints": {

      "type": "array",

      "items": {

        "type": "string"

      }

    },

    "objectives": {

      "type": "array",

      "items": {

        "type": "string"

      }

    },

    "assumptions": {

      "type": "array",

      "items": {

        "type": "string"

      }

    },

    "dependencies": {

      "type": "array",

      "items": {

        "type": "string"

      }

    },

    "notes": {

      "type": "string"

    }

  }

}