    "PROCUREMENT",

    "CONSTRUCTION",

    "INSPECTION",

    "VERIFICATION",

    "AUDIT",

    "COMMISSIONING",

    "COMPLETED",

    "ON_HOLD",

    "CANCELLED",

    "ARCHIVED"

  ]
}